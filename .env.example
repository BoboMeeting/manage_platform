# ============================================================================
# 部署配置模板：复制为 .env 后填入真实值，再 docker compose up -d --build
#   cp .env.example .env && nano .env
# 注意：.env 已在 .dockerignore 中排除，不会进入镜像
# ============================================================================

# 后端对外暴露端口（宿主机端口，容器内固定 5080）
BACKEND_PORT=5080

# PostgreSQL 数据库配置（首次启动会按此创建数据库和用户）
POSTGRES_DB=bobomeet_manager
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-to-strong-password

# JWT 签名密钥：生产环境必须改为高强度随机串，长度 >= 32 字节
# 生成示例：openssl rand -base64 48
JWT_ISSUER=BoboMeet.ManagerPlatform
JWT_AUDIENCE=BoboMeet.Client
JWT_SECRET=change-me-to-32-bytes-or-longer-random-secret
JWT_EXPIRES_SECONDS=604800

# LiveKit 服务（外部部署的另一台机器）
LIVEKIT_URL=ws://livekit.example.com:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-match-livekit-secret
