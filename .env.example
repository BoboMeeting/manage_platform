# ============================================================================
# 部署配置模板：复制为 .env 后填入真实值，再 docker compose up -d --build
#   cp .env.example .env && nano .env
# 注意：.env 已在 .dockerignore 中排除，不会进入镜像
# ============================================================================

# 后端对外暴露端口（宿主机端口，容器内固定 5080）
BACKEND_PORT=5080

# PostgreSQL 数据库配置（首次启动会按此创建数据库和用户）
POSTGRES_DB=bobomeet_manager
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-to-strong-password

# JWT 签名密钥：生产环境必须改为高强度随机串，长度 >= 32 字节
# 生成示例：openssl rand -base64 48
# 重要：JWT_SECRET 必须与调度服务(meet_schedule_server)的 Auth__JwtSecret 完全一致
#   - 管理平台用它签发【服务 JWT】(aud=Service) 调用调度服务内部接口
#   - App 用户 JWT 也用它签发，调度服务外部接口据此验签
JWT_ISSUER=BoboMeet.ManagerPlatform
JWT_AUDIENCE=BoboMeet.Client
JWT_SECRET=change-me-to-32-bytes-or-longer-random-secret
JWT_EXPIRES_SECONDS=604800

# 调度服务（meet_schedule_server）地址
# INTERNAL：管理平台【容器】→ 调度服务的服务间调用地址（由 backend 容器发起）
#   - 调度服务跑在【宿主机】上（本机 dotnet run / 本机开发，默认）：
#       用 http://host.docker.internal:5000
#       ⚠ 容器内的 localhost 指向容器自身、不是宿主机，切勿写 http://localhost:5000
#   - 调度服务容器化且在同一 docker 网络：改用服务名 http://scheduler:5000
SCHEDULER_INTERNAL_URL=http://host.docker.internal:5000
# EXTERNAL：返回给 App 客户端的可达地址（客户端调 /api/v1/external/rooms/*）
#   App 运行在宿主机/用户机器上，localhost 即宿主机，故这里用 localhost 正确；
#   生产环境给外部用户使用时，改为服务器公网 IP 或域名
SCHEDULER_EXTERNAL_URL=http://host.docker.internal:5000

# ============================================================================
# 视频媒体配置（视频处理流水线：上传 → ffprobe 探测 → 转码/打包/字幕）
# ============================================================================
# 容器内媒体文件根目录（原始视频/HLS/字幕，单文件最大 2GB）
#   默认 /app/storage，compose 已挂 named volume(media-storage) 持久化；
#   相对路径会基于 /app 解析。不建议修改，除非同步调整 compose 中的卷挂载点
MEDIA_STORAGE_ROOT=/app/storage
# ffprobe 可执行文件路径（镜像已内置 ffmpeg/ffprobe，默认取 PATH，无需修改）
MEDIA_FFPROBE_PATH=ffprobe
# 转码/打包/字幕模拟阶段每阶段时长（秒），前端联调用；接入真实 FFmpeg Worker 后可移除
MEDIA_SIMULATED_STAGE_SECONDS=3

# nginx HLS 点播服务对外端口（宿主机端口，容器内固定 80）
NGINX_PORT=8088
# HLS 播放基址（backend 通过 play-url 返回给客户端，拼接 videos/{id}/hls/master.m3u8）
# 本地联调用 localhost；生产环境改为服务器 IP/域名，如 http://192.168.1.51:8088/media
# 留空则 play-url 回退为后端签名流式预览原始文件
MEDIA_PUBLIC_BASE_URL=http://localhost:8088/media

# ============================================================================
# RAG 知识库配置
# ============================================================================
# embedding 服务（OpenAI 兼容）。云端 SiliconFlow 需填 ApiKey；
# 本地 TEI（text-embeddings-inference）无鉴权，ApiKey 留空即可。
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# 向量维度：必须与 appsettings.json 的 Rag:EmbeddingDim 一致，且等于模型输出维度。
# ⚠ 更换模型/维度后 kb_chunks 需重建（旧向量长度不兼容），不能原地改配置。
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_TIMEOUT=60
# 二期能力开关（默认关闭，行为与一期一致）
RAG_ENABLE_RERANK=false
# rerank 精排（硅基流动 /v1/rerank）：候选 ≤3 跳过；超时/报错/Key 为空回退原始顺序。
# RAG_RERANK_API_KEY 可与 OCR_API_KEY 填同一个硅基流动 Key。
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CANDIDATE_TOPN=20
RAG_RERANK_TIMEOUT=20
RAG_ENABLE_HYBRID=false

# ============================================================================
# OCR（扫描版 PDF 兜底：硅基流动 PaddleOCR-VL）
# ============================================================================
# 仅当 PDF 文本层平均每页有效字符低于阈值时触发，整篇转 Markdown 后按标题切章节；
# 正常文本层 PDF 不调用，不增加耗时。ApiKey 与 rerank 可共用同一个硅基流动 Key。
# 留空时扫描件判 Failed，错误信息提示 "未配置 Ocr:ApiKey"。
OCR_ENABLED=true
OCR_BASE_URL=https://api.siliconflow.cn/v1
OCR_API_KEY=
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
