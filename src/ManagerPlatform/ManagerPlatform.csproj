<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ManagerPlatform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- JWT 认证 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <!-- 密码哈希（PBKDF2）已由内置 API 提供，无需额外包 -->
    <!-- LiveKit Token 由调度服务（meet_schedule_server）签发，管理平台不再依赖 LiveKit SDK -->
    <!-- .NET 10 内置 OpenAPI 文档生成 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <!-- API 文档 UI（Scalar） -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.0.*" />
    <!-- EF Core + PostgreSQL 持久化 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
  </ItemGroup>

</Project>
