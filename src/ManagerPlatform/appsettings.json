{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=192.168.1.51;Port=5432;Database=bobomeet_manager;Username=admin;Password=admin123;Include Error Detail=true"
  },

  "Jwt": {
    "Issuer": "BoboMeet.ManagerPlatform",
    "Audience": "BoboMeet.Client",
    "Secret": "dev-secret-change-me-please-32bytes-or-more",
    "ExpiresSeconds": 604800
  },

  "Scheduler": {
    "InternalBaseUrl": "http://localhost:5000",
    "ExternalBaseUrl": "http://localhost:5000"
  },

  "Media": {
    "StorageRoot": "storage",
    "FFprobePath": "ffprobe",
    "FFmpegPath": "ffmpeg",
    "SimulatedStageSeconds": 3,
    "PublicBaseUrl": ""
  },

  "Rag": {
    "EmbeddingBaseUrl": "https://api.siliconflow.cn/v1",
    "EmbeddingApiKey": "",
    "EmbeddingModel": "BAAI/bge-m3",
    "EmbeddingDim": 1024,
    "EmbeddingBatchSize": 32,
    "EmbeddingTimeoutSeconds": 60,
    "DefaultTopK": 3,
    "MaxTopK": 5,
    "MinScore": 0.3,
    "ChunkSize": 500,
    "ChunkOverlap": 80,
    "EnableRerank": false,
    "RerankBaseUrl": "https://api.siliconflow.cn/v1",
    "RerankApiKey": "",
    "RerankModel": "BAAI/bge-reranker-v2-m3",
    "RerankCandidateTopN": 20,
    "RerankTimeoutSeconds": 20,
    "EnableHybrid": false
  },

  "Ocr": {
    "Enabled": true,
    "BaseUrl": "https://api.siliconflow.cn/v1",
    "ApiKey": "",
    "Model": "PaddlePaddle/PaddleOCR-VL-1.5",
    "TimeoutSeconds": 120,
    "MaxFileSizeMb": 10,
    "MinCharsPerPage": 20
  }
}
